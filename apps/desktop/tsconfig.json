{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/DesktopShell.tsx", "src/desktop-shell-model.ts", "src/desktop-shell-model.test.ts", "src/desktop-calls-runtime.ts", "src/main.tsx", "src/onboarding.tsx", "src/assets.d.ts"]
}
