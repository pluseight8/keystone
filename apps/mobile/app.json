{
  "expo": {
    "name": "Keystone",
    "slug": "keystone",
    "scheme": "keystone",
    "version": "0.1.0",
    "orientation": "default",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-updates"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.keystone.app"
    },
    "android": {
      "package": "org.keystone.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "keystone",
              "host": "voice"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "../../branding/logos/logo.png",
        "backgroundColor": "#000000"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "../../branding/logos/logo.png",
    "splash": {
      "image": "../../branding/logos/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    }
  }
}
