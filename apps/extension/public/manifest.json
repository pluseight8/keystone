{
  "manifest_version": 3,
  "name": "Keystone Companion",
  "version": "0.1.0",
  "description": "Privately add the current page to your Keystone Life Map.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Index Page",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
