{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystone.local/schemas/addon-manifest-v1.json",
  "title": "Keystone Addon Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "entrypoint", "permissions"],
  "properties": {
    "schema": { "const": "keystone.addon.v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}))*$",
      "maxLength": 253
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 500 },
    "entrypoint": { "type": "string", "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$", "maxLength": 240 },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "enum": ["ai_prompt", "life_map_read", "p2p_request"]
      }
    }
  }
}
