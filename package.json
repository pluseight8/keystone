{
  "name": "keystone",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first peer-to-peer AI superapp",
  "packageManager": "pnpm@9.15.0",
  "workspaces": ["apps/*", "apps/mobile/modules/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --filter @keystone/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @keystone/web build",
    "build:desktop": "pnpm --filter @keystone/desktop build",
    "build:extension": "pnpm --filter @keystone/extension build",
    "build:mobile": "pnpm --filter @keystone/mobile lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @keystone/core test:integration",
    "test:network": "pnpm --filter @keystone/core test:network",
    "test:release-tools": "node --test scripts/*.node-test.mjs",
    "lint": "pnpm -r lint",
    "tsc": "pnpm -r --if-present lint",
    "verify": "pnpm tsc && pnpm test && pnpm build",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare-desktop": "node scripts/prepare-tauri-release-config.mjs"
  },
  "engines": {"node": ">=22 <23"},
  "license": "SEE LICENSE IN LICENSE.md"
}
